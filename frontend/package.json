{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "predev": "node scripts/generate-site-pages.mjs && node scripts/generate-client-i18n.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-site-pages.mjs && node scripts/generate-client-i18n.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/nextjs": "^11.9.0",
    "chart.js": "^4.6.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "html-to-image": "^1.11.13",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.6"
