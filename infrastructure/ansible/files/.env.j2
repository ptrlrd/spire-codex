{% set hooks = lookup('community.hashi_vault.vault_kv2_get', 'spire-codex-discord-webhooks', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set resend = lookup('community.hashi_vault.vault_kv2_get', 'spire-codex-resend', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set admin = lookup('community.hashi_vault.vault_kv2_get', 'spire-codex-admin-token', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set mongo = lookup('community.hashi_vault.vault_kv2_get', 'spire-codex-mongodb', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set umami = lookup('community.hashi_vault.vault_kv2_get', 'spire-codex-umami', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set auth = lookup('community.hashi_vault.vault_kv2_get', 'spire-codex-auth', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set discord = lookup('community.hashi_vault.vault_kv2_get', 'spire-codex-discord-oauth', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set r2_hits = query('community.hashi_vault.vault_kv2_get', 'spire-codex-r2-tierlists', url=bao_url, engine_mount_point=bao_mount, errors='ignore') %}
{% set r2 = r2_hits[0].secret if r2_hits else {} %}
QA_DIR=/data/qa
DATA_DIR=/data
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/knowledge-demon.private-key.pem
FEEDBACK_WEBHOOK_URL={{ hooks.feedback }}
GUIDE_WEBHOOK_URL={{ hooks.guide }}
RESEND_API_KEY={{ resend['api-key'] }}
UNINSTALL_FORWARD_TO={{ resend['forward-to'] }}
UNINSTALL_FORWARD_FROM={{ resend['forward-from'] }}
ADMIN_TOKEN={{ admin.value }}
R2_ACCESS_KEY_ID={{ r2.access_key_id | default('') }}
R2_SECRET_ACCESS_KEY={{ r2.secret_access_key | default('') }}
R2_ENDPOINT={{ r2.endpoint | default('') }}
R2_BUCKET=spire-codex-tierlists
R2_PUBLIC_BASE_URL=https://tierlists.spire-codex.com
MONGO_URL={{ mongo['connection-string'] }}
UMAMI_DB_PASSWORD={{ umami.db_password }}
UMAMI_APP_SECRET={{ umami.app_secret }}
JWT_SECRET={{ auth['jwt-secret'] }}
DISCORD_CLIENT_ID={{ discord['client-id'] }}
DISCORD_CLIENT_SECRET={{ discord['client-secret'] }}
