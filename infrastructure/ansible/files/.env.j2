{% set kv = 'community.hashi_vault.vault_kv2_get' %}
{% set hooks = lookup(kv, 'spire-codex-discord-webhooks', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set resend = lookup(kv, 'spire-codex-resend', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set mongo = lookup(kv, 'spire-codex-mongodb', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set umami = lookup(kv, 'spire-codex-umami', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set umami_login = lookup(kv, 'spire-codex-umami-login', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set auth = lookup(kv, 'spire-codex-auth', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set discord = lookup(kv, 'spire-codex-discord-oauth', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set steam = lookup(kv, 'spire-codex-steam', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set twitch = lookup(kv, 'spire-codex-twitch', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set patreon = lookup(kv, 'spire-codex-patreon', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set kofi = lookup(kv, 'spire-codex-kofi', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set github = lookup(kv, 'spire-codex-github', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set cf = lookup(kv, 'spire-codex-cloudflare', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set workers_ai = lookup(kv, 'spire-codex-workers-ai', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set cf_access = lookup(kv, 'spire-codex-cf-access', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set r2 = lookup(kv, 'spire-codex-r2-tierlists', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set r2_lake = lookup(kv, 'spire-codex-r2-lake', url=bao_url, engine_mount_point=bao_mount).secret %}
{% set cfg = spire_env | combine(spire_env_overrides | default({})) %}
# Rendered by playbooks/sync-secrets.yml from OpenBao and group_vars.
# Do not edit by hand: the next sync replaces the whole file.

# Paths and plain config (group_vars/all.yml spire_env, per-host spire_env_overrides)
{% for key, value in cfg.items() %}
{{ key }}={{ value }}
{% endfor %}

# Sessions and admin
JWT_SECRET={{ auth['jwt-secret'] }}

# Sign-in providers
DISCORD_CLIENT_ID={{ discord['client-id'] }}
DISCORD_CLIENT_SECRET={{ discord['client-secret'] }}
STEAM_WEB_API_KEY={{ steam['api-key'] }}
TWITCH_CLIENT_ID={{ twitch['client-id'] }}
TWITCH_CLIENT_SECRET={{ twitch['client-secret'] }}
PATREON_CLIENT_ID={{ patreon['client-id'] }}
PATREON_CLIENT_SECRET={{ patreon['client-secret'] }}
PATREON_WEBHOOK_SECRET={{ patreon['webhook-secret'] }}

# Thank You page
KOFI_VERIFICATION_TOKEN={{ kofi['verification-token'] }}
GITHUB_TOKEN={{ github.token }}

# Discord webhooks
FEEDBACK_WEBHOOK_URL={{ hooks.feedback }}
GUIDE_WEBHOOK_URL={{ hooks.guide }}

# Resend (uninstall feedback forwarding)
RESEND_API_KEY={{ resend['api-key'] }}
UNINSTALL_FORWARD_TO={{ resend['forward-to'] }}
UNINSTALL_FORWARD_FROM={{ resend['forward-from'] }}

# MongoDB
MONGO_URL={{ mongo['connection-string'] }}
MONGO_ADMIN_PASS={{ mongo['admin-password'] }}

# Umami (docker-compose.umami.yml stack, plus the admin stats login)
UMAMI_DB_PASSWORD={{ umami.db_password }}
UMAMI_APP_SECRET={{ umami.app_secret }}
UMAMI_USERNAME={{ umami_login.username }}
UMAMI_PASSWORD={{ umami_login.password }}

# Cloudflare
CF_TOKEN={{ cf.api_token }}
CF_ZONE={{ cf.zone_id }}
CF_ACCOUNT_ID={{ workers_ai.account_id }}
WORKERS_AI_TOKEN={{ workers_ai.token }}
CF_ACCESS_CLIENT_ID={{ cf_access['client-id'] }}
CF_ACCESS_CLIENT_SECRET={{ cf_access['client-secret'] }}

# R2: tier list previews (backend) and the lake publish (ingest)
R2_ACCESS_KEY_ID={{ r2.access_key_id }}
R2_SECRET_ACCESS_KEY={{ r2.secret_access_key }}
R2_ENDPOINT={{ r2.endpoint }}
LAKE_R2_ACCESS_KEY_ID={{ r2_lake.access_key_id }}
LAKE_R2_SECRET_ACCESS_KEY={{ r2_lake.secret_access_key }}
LAKE_R2_ENDPOINT={{ r2_lake.endpoint }}
LAKE_R2_BUCKET={{ r2_lake.bucket }}
